<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 默认主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1a1a2e</item>
        <item name="colorPrimaryDark">#16213e</item>
        <item name="colorAccent">#e94560</item>
        <item name="android:windowBackground">@color/game_bg</item>
        <item name="android:statusBarColor">#16213e</item>
        <item name="android:navigationBarColor">#0f3460</item>
    </style>

    <!-- 游戏主题（无状态栏） -->
    <style name="GameTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 开屏广告主题 -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- 弹窗主题 -->
    <style name="DialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">#1a1a2e</item>
        <item name="colorPrimaryDark">#16213e</item>
        <item name="colorAccent">#e94560</item>
        <item name="android:windowBackground">@color/dialog_bg</item>
    </style>
</resources>
